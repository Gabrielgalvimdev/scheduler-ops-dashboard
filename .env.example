# Variaveis de ambiente do Scheduler Ops Dashboard
# Copie este arquivo para .env e preencha com seus valores

# --- Backend (Django) ---
DEBUG=True
SECRET_KEY=sua-chave-secreta-mude-em-producao
DATABASE_URL=postgresql://user:pass@localhost:5432/scheduler_db
REDIS_URL=redis://localhost:6379/0
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Frontend (React) ---
VITE_API_URL=http://localhost:8000/api

# --- Producao ---
NODE_ENV=production
DJANGO_SETTINGS_MODULE=scheduler.settings
